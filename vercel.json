{
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/payment-success",
      "destination": "/index.html"
    },
    {
      "source": "/payment-cancelled",
      "destination": "/index.html"
    }
  ]
}
