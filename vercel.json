{
  "rewrites": [
    {
      "source": "/.well-known/apple-app-site-association",
      "destination": "/api/apple-app-site-association"
    },
    {
      "source": "/payment-success",
      "destination": "/index.html"
    },
    {
      "source": "/payment-cancelled",
      "destination": "/index.html"
    },
    {
      "source": "/profile/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/profil/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/event/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/video/:path*",
      "destination": "/index.html"
    }
  ]
}
